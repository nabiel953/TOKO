<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Toko Sepatu - Detail Produk</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <header>
        <div class="header-content">
            <a href="index.html" class="logo">TOKO SEPATU</a>
            <nav>
                <ul>
                    <li><a href="index.html">Beranda</a></li>
                    <li><a href="katalog.html">Katalog</a></li>
                    <li><a href="detail.html">Detail</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <section class="product-detail">
        <div class="container">
            <div class="detail-content" id="detail-content">
                <!-- Diisi oleh JavaScript -->
            </div>
        </div>
    </section>

    <section class="container">
        <div class="form-container" id="form-pemesanan" style="display: none;">
            <h2 class="text-center" style="color: var(--primary-dark);">Form Pemesanan</h2>
            <form id="order-form">
                <input type="hidden" id="product-id">
                <div class="form-group">
                    <label for="name">Nama Lengkap</label>
                    <input type="text" id="name" required placeholder="Masukkan nama Anda">
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" required placeholder="Masukkan email Anda">
                </div>
                <div class="form-group">
                    <label for="model">Model Sepatu</label>
                    <input type="text" id="model" readonly>
                </div>
                <div class="form-group">
                    <label for="size">Ukuran</label>
                    <select id="size" required>
                        <option value="">Pilih Ukuran</option>
                        <!-- Diisi JavaScript -->
                    </select>
                </div>
                <div class="form-group">
                    <label for="quantity">Jumlah</label>
                    <input type="number" id="quantity" min="1" max="10" value="1" required>
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">Pesan Sekarang</button>
            </form>
        </div>
    </section>

    <footer>
        <p>&copy; 2024 Toko Sepatu. All rights reserved.</p>
    </footer>

    <script src="js/data.js"></script>
    <script src="js/form.js"></script>
</body>
</html>
